<Window x:Class="Catalogo.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" 
        Height="650" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1B2838">

    <Window.Resources>
        <!-- Estilo para los botones del menú superior -->
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para los botones del menú lateral -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E5ECEE"/>
            <Setter Property="Background" Value="#2A475E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal dividido en filas: Header y Contenido -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="979*"/>
            <ColumnDefinition Width="21*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Fila 0: Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Fila 1: Cuerpo principal -->
        </Grid.RowDefinitions>

        <!-- 1. BARRA SUPERIOR (HEADER) -->
        <Grid Grid.Row="0" Background="#171A21" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Menú central -->
                <ColumnDefinition Width="Auto"/>
                <!-- Perfil derecha -->
            </Grid.ColumnDefinitions>

            <!-- Menú de navegación principal: TIENDA, COMUNIDAD, SOPORTE -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="TIENDA" Style="{StaticResource TopNavButton}"/>
                <Button Content="COMUNIDAD" Style="{StaticResource TopNavButton}"/>
                <Button Content="SOPORTE" Style="{StaticResource TopNavButton}"/>
            </StackPanel>

            <!-- Perfil de usuario (Esquina superior derecha) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                <!-- Texto que mostrará el nombre de usuario recibido -->
                <TextBlock x:Name="lblUsuarioPerfil" Text="mi perfil" Foreground="#66C0F4" 
                    FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                     <!-- Botón para cerrar sesión -->
                <Button Content="Cerrar sesión" Foreground="#C7D5E0" Background="#A83232" 
                    BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="SemiBold" 
                    Cursor="Hand" Click="BtnCerrarSesion_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. CUERPO PRINCIPAL (LATERAL + CONTENIDO CENTRAL) -->
        <Grid Grid.Row="1" Margin="25,25,4,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- Columna lateral -->
                <ColumnDefinition Width="30"/>
                <!-- Separador -->
                <ColumnDefinition Width="*"/>
                <!-- Catálogo de juegos -->
            </Grid.ColumnDefinitions>

            <!-- 2.1 PANEL LATERAL CON BORDES REDONDEADOS (como en el boceto) -->
            <Border Grid.Column="0" Background="#1A2530" CornerRadius="18" Padding="15,25"
                    BorderBrush="#314B60" BorderThickness="1.5">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="NAVEGACIÓN" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Button Content="Destacados" Style="{StaticResource SidebarButton}"/>
                    <Button Content="Mis juegos" Style="{StaticResource SidebarButton}"/>
                    <Button Content="Configuración" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
            </Border>

            <!-- 2.2 ZONA CENTRAL (CATÁLOGO DE JUEGOS CON BORDE CONTENEDOR) -->
            <Border Grid.Column="2" Background="#1A222D" BorderBrush="#314B60" BorderThickness="1.5" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Juegos Destacados" Foreground="#E5ECEE" 
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <!-- Galería de 3 tarjetas de juegos -->
                    <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top" HorizontalAlignment="Stretch">

                        <!-- Tarjeta Juego 1 -->
                        <Border Background="#212F3D" BorderBrush="#66C0F4" BorderThickness="1" 
            Height="220" Margin="10" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/img/juego1.png" Width="120" Height="120" Stretch="UniformToFill"/>
                                <TextBlock Text="JUEGO 1" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Juego 2 -->
                        <Border Background="#212F3D" BorderBrush="#66C0F4" BorderThickness="1" 
            Height="220" Margin="10" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Nota: Si juego2.webp da problemas en versiones antiguas de WPF, conviértela a .png o .jpg -->
                                <Image Source="/img/juego2.png" Width="120" Height="120" Stretch="UniformToFill"/>
                                <TextBlock Text="JUEGO 2" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Juego 3 -->
                        <Border Background="#212F3D" BorderBrush="#66C0F4" BorderThickness="1" 
            Height="220" Margin="10" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/img/juego3.png" Width="120" Height="120" />
                                <TextBlock Text="JUEGO 3" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>